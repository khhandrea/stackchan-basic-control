# Target: M5Stack CoreS3 in StackChan K151 (ESP32-S3, 16 MB flash, 8 MB quad PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash (same as the official firmware)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (same as the official firmware); keep booting if it fails
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Console on USB-Serial/JTAG: protocol lines go through the driver,
# ESP_LOG output is wrapped into notify.log, panics stay readable as raw text
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_COLORS=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
